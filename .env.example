# SQLite is the default. Set this only when PostgreSQL is available.
# DATABASE_URL=postgresql+psycopg://avito:local_password@localhost:5432/avito_manager

# Generated locally; never share or commit this value.
# JWT_SECRET=<random secret of at least 32 bytes>

# Configure locally when connecting the bot; never share the token.
# TELEGRAM_BOT_TOKEN=<your bot token>

# Docker Compose only. Generate locally; do not commit real passwords.
# POSTGRES_PASSWORD=<random database password>
# API_PORT=8001

# GPT drafts are opt-in. Set secrets locally, never send them in chat.
GPT_REPLIES_ENABLED=false
# OPENAI_API_KEY=<local API key>
# OPENAI_MODEL=<Responses API model available to your account>
# Avito transport is disabled until API contract and account permissions are verified.
